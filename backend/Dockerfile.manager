FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
COPY job-common job-common
COPY job-manager job-manager
RUN sed -i '/<module>job-worker<\/module>/d' pom.xml
RUN mvn -B -q -pl job-manager -am package -DskipTests

FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 jobplatform
WORKDIR /app
COPY --from=build /workspace/job-manager/target/job-manager.jar app.jar
USER jobplatform
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "app.jar"]
