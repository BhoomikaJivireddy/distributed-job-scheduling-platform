        {
          "name": "Create failing job (retries then succeeds)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Flaky job\",\n  \"jobType\": \"FAILURE_SIMULATION\",\n  \"payload\": \"failures=2\\ndelay_ms=500\",\n  \"maxRetries\": 3,\n  \"timeoutSeconds\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('job created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create scheduled job (runs in about 2 minutes)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Scheduled statistics\",\n  \"jobType\": \"DATA_PROCESSING\",\n  \"payload\": \"1, 2, 3, 4, 5\",\n  \"scheduledAt\": \"{{scheduledAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('job created as SCHEDULED', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().status).to.eql('SCHEDULED');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jobId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create idempotent job (send twice)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
