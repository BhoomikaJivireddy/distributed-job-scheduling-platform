{
  "info": {
    "name": "Distributed Job Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('scheduledAt', new Date(Date.now() + 120000).toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "jobId",
      "value": "1"
    },
    {
      "key": "scheduledAt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create text processing job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Word statistics\",\n  \"jobType\": \"TEXT_PROCESSING\",\n  \"payload\": \"The quick brown fox jumps over the lazy dog. The dog sleeps.\",\n  \"priority\": 5,\n  \"maxRetries\": 3,\n  \"timeoutSeconds\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('job created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jobId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create report generation job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
