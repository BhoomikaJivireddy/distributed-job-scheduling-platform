            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Idempotent job\",\n  \"jobType\": \"TEXT_PROCESSING\",\n  \"payload\": \"submitted once\",\n  \"idempotencyKey\": \"postman-demo-key\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created or replayed', () => pm.expect([200, 201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
